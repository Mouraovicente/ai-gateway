{
  "title": "ai-gateway",
  "uid": "ai-gateway",
  "timezone": "browser",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Requests/s by status",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum by (status) (rate(gateway_requests_total[5m]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 2,
      "title": "Latency p50/p95 (ms)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(gateway_latency_ms_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(gateway_latency_ms_bucket[5m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 3,
      "title": "Tokens by model",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum by (model, kind) (rate(gateway_tokens_total[5m]))", "legendFormat": "{{model}} - {{kind}}" }
      ]
    },
    {
      "id": 4,
      "title": "TTFT p50/p95 (ms)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(gateway_ttft_ms_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(gateway_ttft_ms_bucket[5m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 5,
      "title": "Traces (ai-gateway)",
      "type": "traces",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "targets": [
        { "queryType": "traceqlSearch", "filters": [{ "id": "service-name", "tag": "service.name", "operator": "=", "value": ["ai-gateway"], "valueType": "string" }] }
      ]
    }
  ]
}
